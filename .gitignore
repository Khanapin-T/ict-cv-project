# Data and model weights
# Raw data is downloaded by src/prepare_split.py and never committed.
data/*
!data/.gitkeep
*.pth
# Only the final model is committed (see AGENTS.md); per-run checkpoints stay local.
models/*
!models/.gitkeep
!models/best.pth
!models/config.json
*.pt
*.h5
*.ckpt

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Environment and IDE
.env
.vscode/
.idea/
.DS_Store
Thumbs.db
